# ---------- LLM (Groq) ----------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1400
LLM_TIMEOUT_SECONDS=60
LLM_CONTEXT_BUDGET_TOKENS=6000

# ---------- Embeddings / reranking ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------- Vector store ----------
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=printer_manual

# ---------- Default document ----------
DEFAULT_DOCUMENT_PATH=./data/raw/epson_l3310_users_guide.pdf
DEFAULT_DOCUMENT_ID=epson_l3310_manual
DEFAULT_PRODUCT_MODEL=L3310
OCR_ENABLED=true
MAX_UPLOAD_MB=50

# ---------- Chunking ----------
CHUNK_TARGET_TOKENS=550
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP=60
H3_WORD_THRESHOLD=400

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=5
DENSE_CANDIDATES=20
BM25_CANDIDATES=20
RRF_K=60
DENSE_WEIGHT=1.0
BM25_WEIGHT=1.0
RERANK_CANDIDATES=15

# ---------- Sessions ----------
SESSION_MESSAGE_LIMIT=20
SESSION_EXPIRY_DAYS=7
DATABASE_URL=sqlite:///./data/sessions.db

# ---------- API ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for /api/admin/* (sent as X-Admin-Key). Mandatory in production.
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=30
